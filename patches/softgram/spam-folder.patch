     public void processNewMessages(ArrayList<MessageObject> messageObjects, boolean isLast, boolean isFcm, CountDownLatch countDownLatch) {
+        ArrayList<MessageObject> inu_kept = desu.inugram.helpers.dialogs.SpamFolderHelper.filterNotifications(currentAccount, messageObjects);
+        if (inu_kept != null && inu_kept != messageObjects && inu_kept.isEmpty()) {
